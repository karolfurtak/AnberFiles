# Zależności serwera (app/) i lektora (tools/czytaj_tts.py) — WEJŚCIE.
# Instaluje się requirements.txt (wersje == i skróty sha256, także zależności
# przechodnie, wheele dla wszystkich platform). Po zmianie tego pliku:
#   uv pip compile requirements.in --universal \
#       --python-version 3.10 --generate-hashes --annotation-style line -o requirements.txt
# (--python-version 3.10: wersje działające na konsoli Anbernic i na Jarvisie 3.13;
#  19.11.2026 bez --fork-strategy fewest: poprawki bezpieczeństwa pillow 13
#  i soupsieve 4 wymagają Pythona >= 3.11 — uv rozdziela wersje znacznikami
#  python_full_version; Anbernic (3.10) zostaje na ostatnich wersjach dla 3.10)
aiohttp
markdown
nh3                 # sanityzacja HTML podglądu .md (bez niej: HTML pokazany jako tekst)
openpyxl
python-docx
Pillow
edge-tts
num2words
# Eksporter DOCX (katalog_docx, kanoniczny EXPORT/export_to_docx.py + typografia.py
# + lint_styl.py) i lektor bota (EXPORT/czytaj_tts.py) uruchamiane interpreterem
# serwera — lista wyprowadzona skryptem narzedzia/zaleznosci_eksportera.py
# (test: tests/test_zaleznosci_eksportera.py). Licencje: latex2mathml MIT,
# beautifulsoup4 MIT, fonttools MIT, cairosvg LGPL-3.0 (ładowana dynamicznie,
# tylko obrazy SVG; bez niej eksporter pomija SVG — patrz README).
beautifulsoup4
cairosvg
fonttools
latex2mathml
lxml
