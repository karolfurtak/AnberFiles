# Ustawienia instancji AnberFiles — przykład dla Jarvisa (Raspberry Pi 5).
# Kopia robocza leży POZA repozytorium (np. /etc/anberfiles/jarvis.conf),
# a usługa wskazuje ją zmienną ANBERFILES_CONF.
# Hasło NIE w tym pliku. Logowanie „formularz": hasło ustawia się w przeglądarce
# przy pierwszym uruchomieniu (ekran „Ustaw hasło", tylko z sieci prywatnej i Tailscale,
# z jednorazowym tokenem z dziennika usługi — patrz ustaw_haslo_bez_tokenu niżej),
# skrót leży w katalog_danych/auth/; reset: sudo anberfiles-reset-hasla.
# Logowanie „basic": zmienna SERVER_PASS (np. EnvironmentFile=/etc/anberfiles/haslo.env).
# Priorytet: zmienna środowiska (SERVER_HOST, SERVER_PORT, SERVER_USER) > ten plik > domyślne.
# Komentarz w linii: po średniku lub krzyżyku.

[serwer]
nazwa_instancji = Jarvis
host            = 0.0.0.0        ; dostęp z sieci lokalnej odcina zapora systemu
port            = 8790
uzytkownik_www  = admin          ; login okna HTTP Basic (logowanie = basic); przy formularzu nieużywany
haslo_wymagane  = tak            ; przy logowanie = basic: pusty SERVER_PASS = serwer nie startuje
logowanie       = formularz      ; basic = okno HTTP Basic (konsola) · formularz = strona logowania + zapamiętane urządzenie
tylko_odczyt    = tak            ; wgrywanie, usuwanie, zmiana nazwy, nowy katalog → 403
# Ekran „Ustaw hasło" (logowanie = formularz, hasło nieustawione) przyjmuje hasło tylko
# z jednorazowym tokenem startowym — adres z tokenem drukuje usługa do dziennika:
#   sudo journalctl -u anberfiles -n 50 | grep token
# ustaw_haslo_bez_tokenu: adresy/sieci (CIDR, po przecinku lub spacji), z których hasło
# można ustawić BEZ tokenu. Puste = token wymagany od wszystkich (bezpieczna wartość
# domyślna). Przykład (sieci prywatne i Tailscale):
#   ustaw_haslo_bez_tokenu = 192.168.0.0/16, 100.64.0.0/10
# Im węższa lista (np. jeden adres Tailscale własnego laptopa), tym bezpieczniej.
# Ograniczenie do sieci prywatnych i Tailscale obowiązuje zawsze, także z tokenem.
ustaw_haslo_bez_tokenu =
limit_wgrywania_mb = 512        ; łączny rozmiar jednego wgrywania plików (MB), ponad → 413
limit_zip_mb    = 2048           ; łączny rozmiar plików folderu pobieranego jako ZIP (MB), ponad → 413
prog_pamieci_mb = 400            ; serwer + procesy potomne (soffice, lektor): ostrzeżenie w rejestrze zdarzeń
# Ochrona przed DNS rebinding: serwer przyjmuje w adresie (nagłówek Host) tylko adres IP,
# localhost, nazwy *.local i nazwy z tej listy (po przecinku lub spacji); inne → 421.
# Wpis z kropką na początku = sufiks, np. .ts.net (nazwy MagicDNS Tailscale).
dozwolone_hosty =
# LibreOffice (podgląd DOCX, druk) bez dostępu do sieci — dokument z polem INCLUDEPICTURE
# http://… nie każe serwerowi pobierać adresów. auto = bwrap --unshare-net albo unshare -n,
# gdy działają (inaczej zwykły soffice + ostrzeżenie w rejestrze zdarzeń przy starcie);
# tak = wymagane (bez piaskownicy podgląd DOCX i druk odmawiają); nie = bez piaskownicy.
# Uwaga: RestrictNamespaces=yes w jednostce systemd blokuje bwrap — patrz README.
soffice_bez_sieci = auto
limit_druku_na_godzine = 20      ; zadań druku na godzinę (okno przesuwne), ponad → 429
# Link „🏠 <nazwa_instancji>” w nagłówku listy katalogów i w paskach widoków podglądu —
# odnośnik do strony startowej serwera. Tylko adres http:// lub https://; puste = brak linku.
# Przykład: strona_startowa = http://adres-serwera:port/
strona_startowa =
# Czas (s) na odczyt katalogu; po nim serwer odpowiada 504 z czytelną stroną i wpisem w rejestrze
# zdarzeń, zamiast czekać na zawieszony zdalny system plików (np. sshfs do wyłączonego komputera).
# Błąd systemu plików (urządzenie odmontowane, brak połączenia) → 503. Dozwolona wartość ułamkowa.
limit_odczytu_katalogu_s = 3
# Nagrania lektora w katalog_lektora starsze niż tyle dni serwer usuwa sam (sprawdzenie przy starcie
# i co godzinę; wpis w rejestrze zdarzeń). Usunięte nagranie można wygenerować ponownie. 0 = nie wygasają.
wiek_nagran_dni = 3
# Nagrania lektora odświeżane po zmianie dokumentu. Przy starcie i co minutę serwer porównuje odcisk
# SHA-256 części czytanej dokumentu z odciskiem zapisanym przy nagraniu (<nazwa>_lektor.zrodlo.json) —
# tylko dla dokumentów, które MAJĄ nagranie. Tryby:
#   nie         — bez przeglądu (Anbernic, domyślnie)
#   natychmiast — inny odcisk → zadanie w kolejce lektora od razu (dawne „tak”; przy kilku poprawkach
#                 z rzędu urządzenie nagrywa kilka razy)
#   nocą        — inny odcisk tylko OZNACZA nagranie jako nieaktualne (przycisk „🔄 nagraj teraz” przy
#                 nagraniu); o lektor_godzina_nocna jeden przebieg zleca wszystkie nieaktualne, raz na
#                 dokument, tym samym głosem; od lektor_nocne_okno_do nowych nagrań nie zaczyna —
#                 pozostałe przechodzą na kolejną noc (Jarvis: nocą, 03:00, 06:30)
# Zadania automatyczne ustępują zleconym ręcznie i czekają, gdy Puls (puls_adres) ma trwający bieg.
# Godziny wg zegara urządzenia (timedatectl), zapis 24-godzinny GG:MM.
lektor_auto_odswiezanie = nie
lektor_godzina_nocna = 03:00
lektor_nocne_okno_do = 06:30
puls_adres      = http://localhost:7777   ; /api/status Pulsa; puste = bez sprawdzania

[katalogi]
katalog_glowny   = /srv/anberfiles/korzen
katalog_danych   = /srv/anberfiles/dane     ; jedyne miejsce zapisu (oprócz katalogu lektora)
rejestr_zdarzen  = /srv/anberfiles/dane/anberfiles-events.log
kolejka_lektora  = /srv/anberfiles/dane/lektor_queue.json
bledy_lektora    = /srv/anberfiles/dane/lektor_errors.log
bledy_druku      = /srv/anberfiles/dane/print_errors.log
dziennik_dostepu = /srv/anberfiles/dane/access.log   ; adres, metoda, ścieżka (token=*** ), kod, bajty, czas; rotacja 5 × 5 MB
katalog_lektora  = /srv/anberfiles/korzen/lektor   ; musi leżeć w katalog_glowny
pamiec_podr_docx = /srv/anberfiles/dane/cache/docx-preview
katalog_zip_tmp  = /srv/anberfiles/dane/zip_tmp
katalog_eksportu = /srv/anberfiles/eksport          ; czytaj_tts.py + lektor-ustawienia.conf
favikona         = /srv/anberfiles/dane/favicon.ico
kosz             = /srv/anberfiles/dane/kosz
# bez_drzewa: nazwy (po przecinku) katalogów PIERWSZEGO poziomu katalog_glowny, których poddrzewa
# eksplorator (?explorer=1) nie rozwija — dla bardzo dużych lub zdalnych zasobów. Wpis katalogu
# w drzewie zostaje, listing po kliknięciu działa normalnie. Puste = rozwijane wszystkie.
# Przykład: bez_drzewa = nazwa-katalogu-1, nazwa-katalogu-2
bez_drzewa       =
# Lista „Do przesłuchania” (moduł przesluchania): katalog notatek (musi leżeć w katalog_glowny)
# i opcjonalny plik propozycji klasyfikacji — tabela Markdown z wierszami | `ścieżka` | rodzaj | status |,
# ścieżki względem przesluchania_zakres. Notatka trafia na listę, gdy ma w nagłówku status: do-akceptacji
# (albo zaakceptowane-niewdrozone) albo gdy jest w pliku propozycji. Decyzje: katalog_danych/przesluchania.json,
# eksport dla agenta przenoszącego je do vaulta: katalog_danych/przesluchania-eksport.md.
przesluchania_zakres    = /srv/anberfiles/korzen/vault
przesluchania_kandydaci =

[moduly]
podglad_docx    = tak
eksport_docx    = nie
lektor          = tak
lektor_opisy_ai = nie
wylaczanie      = nie
druk            = tak
bateria         = nie
kadrowanie      = nie
przesluchania   = tak            ; lista „Do przesłuchania” z decyzjami (Anbernic: domyślnie nie)
