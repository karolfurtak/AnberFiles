# Ustawienia lektora (tools/czytaj_tts.py) — przykład dla instancji bez karty TF konsoli.
# Plik leży obok czytaj_tts.py w katalogu eksportu (klucz katalog_eksportu).
# Format: klucz = wartość, komentarz po #.

format         = mp3      # mp3 | wav | flac (wav/flac wymagają mpg123 i flac)
voice          = marek
rate           = +0%
kopiuj_do      = nie      # brak biblioteki Music konsoli — bez kopii
opisuj_grafiki = nie      # opisy ilustracji modelem wizyjnym wyłączone
# home_opisow  = /root    # katalog domowy dla programu opisującego ilustracje

# Silnik mowy: edge  = głosy online Microsoftu (wymaga internetu, jak na Anbernicu)
#              piper = lokalna usługa Piper (serwer_tts.py), bez internetu; tylko głos
#                      polski pl_PL-darkman-medium — wstawki angielskie czyta polską wymową;
#                      mp3/flac przez ffmpeg, wav bez dodatkowych programów.
# Parametr --silnik ma pierwszeństwo. voice/rate dotyczą tylko edge (tempo Pipera ustawia usługa).
# Bez linii „silnik": piper, gdy usługa pod piper_adres odpowiada (tekst zostaje na urządzeniu),
# inaczej edge. Przy edge lektor zapisuje do dziennika „tekst opuszcza urządzenie
# (usługa Microsoft)", a okno lektora w przeglądarce pokazuje ten sam napis.
silnik         = edge
piper_adres    = http://127.0.0.1:8123
